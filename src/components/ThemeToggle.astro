<button class="theme" type="button" data-theme-toggle aria-label="Switch theme">
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
</button>

<style>
  .theme { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; color: var(--muted); transition: color var(--d-hover) var(--ease), background-color var(--d-hover) var(--ease); }
  .theme:hover, .theme:focus-visible { color: var(--text); background: color-mix(in srgb, var(--primary) 8%, transparent); }
  .theme svg { width: 18px; height: 18px; }
  /* show the action, not the state: moon in light mode, sun in dark mode */
  .sun { display: none; }
  .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun { display: block; }
    :global(:root:not([data-theme="light"])) .moon { display: none; }
  }
  :global(:root[data-theme="dark"]) .sun { display: block; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const current = () => {
    const t = root.getAttribute('data-theme');
    if (t === 'dark' || t === 'light') return t;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const label = () => {
    if (btn) btn.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  };
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });
  label();
</script>
