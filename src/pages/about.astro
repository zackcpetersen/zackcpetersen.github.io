---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RailRow from '../components/RailRow.astro';
import { site } from '../data/site';
import trail from '../assets/trail.jpg';
import ridge from '../assets/ridge.jpg';
import fishing from '../assets/fishing.jpg';
---
<Base title={site.meta.about.title} description={site.meta.about.description} path="/about/">
  <RailRow>
    <section class="section">
      <p class="eyebrow">About</p>
      <h1 class="h">{site.about.heading}</h1>
      <figure>
        <Image class="photo" src={trail} width={1120} widths={[560, 1120]} sizes="(max-width: 760px) 100vw, 560px" quality={72} alt="Zack sitting on a wooden fence on a trail above a river" loading="eager" />
        <figcaption class="mono cap">{site.about.captions.trail}</figcaption>
      </figure>
      {site.about.paragraphs.map(p => <p>{p}</p>)}
      <div class="pair">
        <figure>
          <Image class="photo" src={ridge} width={560} widths={[280, 560]} sizes="(max-width: 760px) 50vw, 280px" alt="Zack in a hooded sun shirt on a mountain trail" />
          <figcaption class="mono cap">{site.about.captions.ridge}</figcaption>
        </figure>
        <figure>
          <Image class="photo" src={fishing} width={560} widths={[280, 560]} sizes="(max-width: 760px) 50vw, 280px" alt="Zack holding a trout beside a river" />
          <figcaption class="mono cap">{site.about.captions.fishing}</figcaption>
        </figure>
      </div>
      <p><a class="link-text" href={site.resume}>Resume (PDF)</a></p>
    </section>
  </RailRow>
</Base>

<style>
  .h { font-size: var(--h2); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 16px; }
  figure { margin: 0; }
  .photo { width: 100%; max-width: 560px; height: auto; border-radius: 16px; margin: 8px 0 10px; }
  .cap { color: var(--muted); margin-bottom: 20px; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 560px; margin: 24px 0 28px; }
  .pair .photo { margin: 0 0 8px; border-radius: 12px; }
  .pair .cap { margin-bottom: 0; }
</style>
