---
import Base from '../layouts/Base.astro';
import RailRow from '../components/RailRow.astro';
import Job from '../components/Job.astro';
import Project from '../components/Project.astro';
import { site } from '../data/site';
---
<Base title={site.meta.work.title} description={site.meta.work.description} path="/work/">
  <RailRow>
    <section class="section">
      <p class="eyebrow">Work</p>
      <h1 class="h">{site.workPageHeading}</h1>
    </section>
  </RailRow>
  {site.work.map(role => (
    <RailRow>
      <Job role={role} />
    </RailRow>
  ))}

  <RailRow id="projects">
    <section class="section">
      <p class="eyebrow">{site.projectsEyebrow}</p>
      <h2>{site.projectsIntro}</h2>
    </section>
  </RailRow>
  <RailRow node="none">
    <div class="grid">
      {site.projects.map(p => <Project project={p} />)}
    </div>
  </RailRow>
</Base>

<style>
  .h { font-size: var(--h2); line-height: 1.1; letter-spacing: -0.02em; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 8px 0 24px; }
  @media (max-width: 760px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
